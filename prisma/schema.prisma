generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  initials    String   @unique
  pinHash     String
  createdAt   DateTime @default(now())
}

model CorrectiveAction {
  id               String   @id @default(cuid())
  title            String
  summary          String?
  sourceType       String
  ncrReference     String
  reportedBy       String?
  supplierInvolved Boolean  @default(false)
  status           String   @default("open")
  currentStep      String   @default("intake")
  createdAt        DateTime @default(now())
}
